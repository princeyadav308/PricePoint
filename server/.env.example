# ─── Database ─────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# ─── Payments (Dodo) ─────────────────────────────────────
DODO_PAYMENTS_API_KEY="your_dodo_api_key"
DODO_WEBHOOK_SECRET="your_dodo_webhook_secret"
DODO_API_URL="https://test.dodopayments.com"  # Change to https://api.dodopayments.com for live

# ─── AI ──────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."
CLAUDE_TIMEOUT_MS=300000

# ─── Intelligence APIs ──────────────────────────────────
ABSTRACTAPI_GEOLOCATION_KEY="your_key"
CRAWL4AI_API_URL="http://localhost:11235"  # Crawl4AI sidecar/Docker URL
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""
FIXER_API_KEY=""

# ─── Rate Limit Config ───────────────────────────────────
MAX_COMPETITOR_SCRAPES=5
INTELLIGENCE_TIMEOUT_MS=30000
INTELLIGENCE_CALLS_PER_IP_PER_DAY=50

# ─── Email ───────────────────────────────────────────────
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="reports@yourdomain.com"

# ─── Application ─────────────────────────────────────────
APP_URL="https://yourdomain.com"
ALLOWED_ORIGINS="https://yourdomain.com,https://www.yourdomain.com"
PORT=3000
NODE_ENV=production
